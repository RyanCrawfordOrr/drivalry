# Secrets (keys live in .env; .env.example is the committed template)
.env
.env.*
!.env.example

# Node / TypeScript spec package
node_modules/
coverage/
dist/
*.log
*.tsbuildinfo

# Dart / Flutter (app/ has its own .gitignore as well)
.dart_tool/
.packages
build/
packages/*/pubspec.lock

# Python (tools/packs)
__pycache__/
*.pyc
.venv/

# OS / editors
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# Local dev binaries (sqlite3.dll for Windows tests; see tools/dev/)
.tools/

# Firebase config (contains the sender id; keep out of the public repo)
app/android/app/google-services.json
app/ios/Runner/GoogleService-Info.plist
