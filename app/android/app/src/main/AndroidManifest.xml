<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network: Supabase, Google Maps tiles, pack downloads. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Tracking plugin (docs/08-tracking-channel.md §6). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Crash countdown over the lock screen. Android 14+ grants this only to
         apps whose core function needs it; the user may have to allow it in
         Settings > Apps > Special app access if the OS revoked it. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Pre-31 equivalent needed to receive ACL connect/disconnect broadcasts. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Convoy radio (docs/10 §4): microphone for push-to-talk, a foreground
         service while the radio is on, and audio-mode changes for ducking. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:label="Drivalry"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">

        <!-- Google Maps SDK key, supplied by the GOOGLE_MAPS_API_KEY dart-define
             (flutter build with the dart-define-from-file option pointing at ../.env;
             see app/build.gradle.kts). Empty when the define is absent. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${googleMapsApiKey}" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- drivalry:// deep links (ADR-018 invite links). launchMode is singleTop, so a
                 link opened while the app runs reaches the existing activity's onNewIntent
                 and the Flutter app_links plugin picks it up. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="drivalry" />
            </intent-filter>
        </activity>

        <!-- Trip recording: GPS 1 Hz batched + 20 Hz linear acceleration. Runs only
             while a trip is tentative or active; the service stops itself afterwards. -->
        <service
            android:name=".tracking.TrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- IN_VEHICLE ENTER/EXIT from the Activity Recognition Transition API.
             Targeted by an explicit PendingIntent, so it stays unexported; the
             permission guard ensures only Play services can deliver to it. -->
        <receiver
            android:name=".tracking.ActivityTransitionReceiver"
            android:exported="false"
            android:permission="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />

        <!-- 100 m EXIT geofence around the last parking spot (explicit PendingIntent). -->
        <receiver
            android:name=".tracking.GeofenceReceiver"
            android:exported="false" />

        <!-- PRIORITY_PASSIVE parked backstop (explicit PendingIntent). -->
        <receiver
            android:name=".tracking.PassiveLocationReceiver"
            android:exported="false" />

        <!-- Car Bluetooth connect/disconnect. ACL broadcasts are protected system
             broadcasts sent by the Bluetooth stack (its own uid), so the receiver
             must be exported to receive them. -->
        <receiver
            android:name=".tracking.BluetoothReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Re-arms the transition request, geofence and passive request after a
             reboot or an app update (both clear Play services registrations). -->
        <receiver
            android:name=".tracking.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Convoy radio foreground service (docs/10 §4). -->
        <service
            android:name=".convoy.ConvoyAudioService"
            android:exported="false"
            android:foregroundServiceType="microphone|mediaPlayback" />
        <!-- Spotify PKCE callback for flutter_web_auth_2. Uses its own scheme so
             the drivalry:// deep-link filter on MainActivity never competes
             with it (two matching activities would show a chooser). -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="drivalry-auth" />
            </intent-filter>
        </activity>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
